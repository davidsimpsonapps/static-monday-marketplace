{#
  Badges linking companies that are both a monday.com marketplace vendor and a
  monday.com partner (see partnerIds / vendorIds in vendor-details.json and
  partner-details.json). Badges are plain spans so they can sit inside cards
  that are already links; pages add a separate visible link.
#}

{# Shown on partner cards/pages: this partner also sells marketplace apps. #}
{% macro vendorBadge(vendorName) %}
<span data-toggle="tooltip" title="Also a monday.com marketplace vendor{% if vendorName %}: {{ vendorName }}{% endif %}">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="icon_a812034417 Rv7UF clickable_e41bd603c6" data-testid="icon">
        <rect x="2" y="2" width="7" height="7" rx="1.5" fill="#FF3D57"></rect>
        <rect x="11" y="2" width="7" height="7" rx="1.5" fill="#FFCB00"></rect>
        <rect x="2" y="11" width="7" height="7" rx="1.5" fill="#00CA72"></rect>
        <rect x="11" y="11" width="7" height="7" rx="1.5" fill="#6161FF"></rect>
    </svg>
</span>
{% endmacro %}

{# Shown on vendor cards/pages: this vendor is also a monday.com partner.
   tier is the partner API tier, e.g. "PLATINUM". #}
{% macro partnerBadge(tier, partnerName) %}
{% set colours = { "PLATINUM": "#5559DF", "GOLD": "#FFCB00", "SILVER": "gray", "BRONZE": "#C25531", "AUTHORIZED": "#00A9FF" } %}
<span data-toggle="tooltip" title="Also a monday.com {{ tier | lower | capitalize }} partner{% if partnerName %}: {{ partnerName }}{% endif %}">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="icon_a812034417 Rv7UF clickable_e41bd603c6" data-testid="icon">
        <path d="M10 2.5 17 9l-7 8.5L3 9l7-6.5Z" fill="{{ colours[tier] or '#5559DF' }}"></path>
        <path d="M7 9.2 9.2 11.4 13.2 7.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
</span>
{% endmacro %}

{# Shown on cards/pages for a company that presents itself as based in one
   country but is based in another (see the offshoreStatus filter).
   status.level is "confirmed" (red) or "possible" (orange). #}
{% macro offshoreBadge(status, srText = true) %}
{% if status %}
<span data-toggle="tooltip" title="{{ status.text }}" data-offshore="{{ status.level }}">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="icon_a812034417 Rv7UF clickable_e41bd603c6" data-testid="icon">
        <circle cx="10" cy="10" r="7.25" stroke="{{ '#E2445C' if status.level == 'confirmed' else '#FDAB3D' }}" stroke-width="1.5"></circle>
        <path d="M2.75 10h14.5M10 2.75c1.9 2 2.9 4.4 2.9 7.25S11.9 15.25 10 17.25M10 2.75C8.1 4.75 7.1 7.15 7.1 10s1 5.25 2.9 7.25" stroke="{{ '#E2445C' if status.level == 'confirmed' else '#FDAB3D' }}" stroke-width="1.2"></path>
        <circle cx="15.5" cy="4.5" r="3.5" fill="{{ '#E2445C' if status.level == 'confirmed' else '#FDAB3D' }}"></circle>
        <path d="M15.5 2.8v2M15.5 6.1v.05" stroke="#fff" stroke-width="1.3" stroke-linecap="round"></path>
    </svg>
    {% if srText %}<span class="sr-only">{{ status.text }}</span>{% endif %}
</span>
{% endif %}
{% endmacro %}
